NODE_ENV=development
PORT=5000


MONGODB_URI=mongodb://localhost:27017/

# Must be at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=@gmail.com
SMTP_PASS=ufdfi s sinfisnf ifisnf
EMAIL_FROM=Bookstore <no-reply@bookstore.local>

# ---- Redis (cache + shared rate limits). Leave REDIS_URL unset to disable.
REDIS_URL=redis://localhost:6379
BOOK_CACHE_TTL_SECONDS=120

# ---- RabbitMQ (async events: emails, alerts). Leave RABBITMQ_URL unset to keep events in-process.
RABBITMQ_USER=bookstore
RABBITMQ_PASS=bookstore
RABBITMQ_URL=amqp://bookstore:bookstore@localhost:5672
ENABLE_CONSUMERS=true        # docker compose sets this to false for the api and true for the worker
RABBITMQ_PREFETCH=10
EVENT_MAX_RETRIES=3
EVENT_RETRY_DELAY_MS=10000

# ---- Razorpay (online payments). Leave unset to offer cash-on-delivery only.
RAZORPAY_KEY_ID="rzp_test_TsppxwgFii5NQ8"
RAZORPAY_KEY_SECRET="YtlNdqKDEK5xEjgmQgxfer6V"
RAZORPAY_WEBHOOK_SECRET="choose-a-secret-string-for-webhook-validation"